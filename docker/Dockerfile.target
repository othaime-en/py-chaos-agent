# syntax=docker/dockerfile:1
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

# Unprivileged user, different from the chaos agent's (10001) so that the agent
# really does need CAP_KILL to signal this process.
RUN groupadd --system --gid 10002 app \
    && useradd --system --uid 10002 --gid app --no-create-home \
        --shell /usr/sbin/nologin app

WORKDIR /app
COPY docker/target-app.py .

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10002:10002
EXPOSE 8080
CMD ["python", "target-app.py"]
