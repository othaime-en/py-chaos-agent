# Copy to .env (git-ignored) and set real values:
#   {
#     echo "CHAOS_API_TOKEN=$(openssl rand -hex 32)"
#     echo "CHAOS_METRICS_TOKEN=$(openssl rand -hex 32)"
#   } > .env
#
# The control API token. Gives full access.
CHAOS_API_TOKEN=
# The token Prometheus presents to scrape /metrics. It must be different from the
# API token: it sits in Prometheus's configuration and must not be able to start
# chaos.
CHAOS_METRICS_TOKEN=
